___TESTS___

scenarios:
- name: Adds the site file for the key
  code: |-
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      assertThat(url).isEqualTo('https://cdn.prodiax.app/s/pk_live_AbC123AbC123AbC123AbC1.js');
      assertThat(cacheToken).isEqualTo('prodiax');
      onSuccess();
    });
    runCode({ siteKey: 'pk_live_AbC123AbC123AbC123AbC1' });
    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Reports a failure when the file does not load
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => {
      onFailure();
    });
    runCode({ siteKey: 'pk_test_AbC123AbC123AbC123AbC1' });
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();


