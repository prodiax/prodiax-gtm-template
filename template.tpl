___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');

// The site's file on the Prodiax CDN: the A/B loader, the site's plan and the
// start of the tracking SDK. Prodiax rewrites it whenever a test or fix changes.
const url = 'https://cdn.prodiax.app/s/' + encodeUriComponent(data.siteKey) + '.js';

// With the cache token, a tag fired twice on one page adds the file once.
injectScript(url, data.gtmOnSuccess, data.gtmOnFailure, 'prodiax');


